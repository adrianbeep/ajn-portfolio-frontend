# Backend API base URL. Used by src/lib/api-client.ts via import.meta.env.
# This env var is read ONLY at build time (server-side data fetching from
# page frontmatter and getStaticPaths). The browser-side auth scripts in
# src/pages/admin/*.astro hardcode `/api/admin/...` paths, which go through
# the Vite dev proxy in dev (see astro.config.mjs -> vite.server.proxy) and
# Vercel rewrites in production.
#
# The value MUST be an absolute URL because undici (Node's fetch) refuses
# relative URLs. Keep aligned with the `http` profile in
# ajn-portfolio-backend/Api/Properties/launchSettings.json.
PUBLIC_API_BASE_URL=http://localhost:5239