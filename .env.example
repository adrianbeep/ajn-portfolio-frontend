# Backend API base URL. Used by src/lib/api.ts via import.meta.env.
#
# This env var is read ONLY at build time (server-side data fetching from
# page frontmatter and getStaticPaths). Nothing is fetched at runtime: the
# site is static and the content is baked into the HTML.
#
# The value MUST be an absolute URL because undici (Node's fetch) refuses
# relative URLs.
#
# The port depends on how the backend is running:
#
#   dotnet run              -> http://localhost:5239
#   docker compose up       -> http://localhost:8080
#   node stub/server.mjs    -> http://localhost:5239
#
# Pointing at the wrong port is the most common mistake here: the build
# still succeeds, but it publishes the site without projects and logs a
# warning.
PUBLIC_API_BASE_URL=http://localhost:5239

# Canonical origin for canonical links, the sitemap and robots.txt.
# Optional: defaults to https://ajn-portfolio.vercel.app
# SITE_URL=https://ajn-portfolio.vercel.app
