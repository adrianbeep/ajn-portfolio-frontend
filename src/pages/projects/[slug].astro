---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkdownContent from "../../components/MarkdownContent.astro";
import TechTag from "../../components/TechTag.astro";
import { getAllProjects } from "../../lib/api";
import { renderMarkdown } from "../../lib/markdown";
import { toTechTags } from "../../lib/tech-tags";
import type { ProjectDetailDto } from "../../lib/types";

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectDetailDto;
}

const { project } = Astro.props;
const html = await renderMarkdown(project.content);
const year = new Date(project.createdAt).getUTCFullYear();
// Un proyecto sin tecnologías no dibuja lista: el detalle se queda igual.
const tags = toTechTags(project.technologies);
---

<BaseLayout
  title={`${project.title} — AJN`}
  description={project.description}
  path={`/projects/${project.slug}/`}
>
  <div class="container">
    <article class="detail">
      <a class="detail__back" href="/projects/">← Volver a proyectos</a>
      <div>
        <p class="eyebrow">{project.state}</p>
        <h1>{project.title}</h1>
      </div>
      <p class="hero__lede">{project.description}</p>
      <div class="detail__meta">
        <span class="meta">{year}</span>
        <span class="meta">/{project.slug}</span>
      </div>
      {
        tags.length > 0 && (
          <ul class="detail__tags">
            {tags.map((tag) => (
              <li>
                <TechTag label={tag.label} iconPath={tag.iconPath} />
              </li>
            ))}
          </ul>
        )
      }
      {
        project.urlThumbnail && (
          /* Si la miniatura no carga se saca el contenedor entero, no sólo
             el <img>: el div tiene aspect-ratio 4/3 y sin la imagen se queda
             como una caja vacía de 762px de alto al principio de la entrada. */
          <div class="detail__cover">
            <img
              src={project.urlThumbnail}
              alt=""
              loading="lazy"
              decoding="async"
              onerror="this.closest('.detail__cover')?.remove()"
            />
          </div>
        )
      }
      <MarkdownContent html={html} />
    </article>
  </div>
</BaseLayout>
