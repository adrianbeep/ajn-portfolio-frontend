---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ListToggle from "../../components/ListToggle.astro";
import Pagination from "../../components/Pagination.astro";
import { getAllProjectSummaries, PROJECTS_PAGE_SIZE } from "../../lib/api";
import type { ProjectSummaryDto } from "../../lib/types";

export const getStaticPaths = (async ({ paginate }) => {
  // El listado se construye SÓLO con resúmenes. Antes resolvía el detalle
  // de cada proyecto para pintar el año y el estado: un pedido por tarjeta
  // (N+1) que, además, hacía que un fallo puntual de la API escondiera
  // proyectos del listado sin avisar. Los dos datos viajan en el resumen.
  const summaries = await getAllProjectSummaries();
  return paginate(summaries, { pageSize: PROJECTS_PAGE_SIZE });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<ProjectSummaryDto>;
}

const { page } = Astro.props;

const currentPage = page.currentPage;
const lastPage = page.lastPage;

/** Base del listado: la primera página es "/projects/", las demás "/projects/{n}/". */
const pagePath = (number: number) => (number === 1 ? "/projects/" : `/projects/${number}/`);

/** Los links del head (rel=prev/next) son absolutos, como el canonical. */
const absoluteUrl = (path: string) => new URL(path, Astro.site ?? Astro.url).href;

const canonicalPath = pagePath(currentPage);
const prevUrl = currentPage > 1 ? absoluteUrl(pagePath(currentPage - 1)) : undefined;
const nextUrl = currentPage < lastPage ? absoluteUrl(pagePath(currentPage + 1)) : undefined;

const title = currentPage === 1 ? "Proyectos — AJN" : `Proyectos — AJN · Página ${currentPage}`;
const description = "Proyectos de AJN: software con backend .NET y frontends estáticos.";
---

<BaseLayout title={title} description={description} path={canonicalPath} prevUrl={prevUrl} nextUrl={nextUrl}>
  <div class="container">
    <section class="section" id="proyectos" aria-labelledby="h-proyectos">
      <div class="section-head">
        <h1 id="h-proyectos">Proyectos</h1>
        <span class="section-count">{page.total} proyectos</span>
      </div>
      <ListToggle active="projects" />
      {
        page.data.length > 0 ? (
          <div class="card-list">
            {page.data.map((project) => (
              <ProjectCard project={project} headingLevel={2} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>Todavía no hay proyectos publicados. El listado se completa a medida que se publica el detalle de cada uno.</p>
          </div>
        )
      }
      <Pagination
        currentPage={currentPage}
        lastPage={lastPage}
        total={page.total}
        pageSize={page.size}
        baseUrl="/projects"
        label="Paginación de proyectos"
      />
    </section>
  </div>
</BaseLayout>
