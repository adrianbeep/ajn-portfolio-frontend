---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Pagination from '../../components/Pagination.astro';
import { listProjects } from '../../lib/api';

export async function getStaticPaths() {
  // Only the index page (page 1). Subsequent pages live in [...page].astro.
  return [{ params: {} }];
}

const { items, total, page, pageSize } = await listProjects({ page: 1 });
const totalPages = Math.ceil(total / pageSize);
const [featured, ...rest] = items;
---

<BaseLayout title="Projects · AJN Portfolio" description="Personal projects">
  <main>
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">Listings</span>
        <h1>Projects</h1>
        <p class="lede">Personal projects — código que escribí, cosas que aprendí.</p>
      </header>

      {items.length === 0 ? (
        <p class="empty">No projects yet.</p>
      ) : (
        <>
          {featured && (
            <div class="featured-grid">
              <ProjectCard project={featured} variant="featured" />
              {rest.length > 0 && (
                <div class="rest-grid">
                  {rest.slice(0, 3).map((p) => <ProjectCard project={p} />)}
                </div>
              )}
            </div>
          )}
          {!featured && (
            <div class="regular-grid">
              {items.map((p) => <ProjectCard project={p} />)}
            </div>
          )}
          {rest.length > 3 && (
            <div class="more-grid">
              {rest.slice(3).map((p) => <ProjectCard project={p} />)}
            </div>
          )}
        </>
      )}

      <Pagination currentPage={page} totalPages={totalPages} basePath="/projects" />
    </div>
  </main>
</BaseLayout>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }
  main {
    padding-block: var(--space-12) var(--space-24);
  }
  .page-header {
    margin-bottom: var(--space-12);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-block: var(--space-3) var(--space-4);
  }
  .lede {
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 38rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .eyebrow::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: var(--color-accent);
    display: inline-block;
  }
  .empty {
    color: var(--color-muted);
    font-style: italic;
    padding-block: var(--space-12);
    text-align: center;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (max-width: 800px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
  .rest-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .regular-grid,
  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .more-grid {
    margin-top: var(--space-6);
  }
</style>