---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';

const redirectTo = Astro.url.searchParams.get('redirect') ?? '/admin';
---

<BaseLayout title="Admin · Iniciar sesión · AJN Portfolio">
  <main>
    <div class="login-shell">
      <div class="login-card">
        <p class="eyebrow">Admin</p>
        <h1>Iniciar sesión</h1>
        <p class="lede">Administrar proyectos y contribuciones.</p>

        <form id="login-form" data-redirect={redirectTo} novalidate>
          <label class="field">
            <span class="field__label">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              class="field__input"
              data-input-email
            />
          </label>

          <label class="field">
            <span class="field__label">Contraseña</span>
            <input
              type="password"
              name="password"
              required
              autocomplete="current-password"
              class="field__input"
              data-input-password
            />
          </label>

          <button type="submit" class="submit-btn" data-submit>
            <span class="submit-btn__label" data-submit-label>Iniciar sesión</span>
            <span class="submit-btn__spinner" data-submit-spinner aria-hidden="true" hidden></span>
          </button>

          <p class="error" data-error role="alert" hidden>
            <span class="error__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </span>
            <span data-error-message></span>
          </p>
        </form>

        <a href="/" class="login-back">Volver al sitio</a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorEl = document.querySelector<HTMLElement>('[data-error]');
  const errorMsgEl = document.querySelector<HTMLElement>('[data-error-message]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit]');
  const submitLabelEl = document.querySelector<HTMLElement>('[data-submit-label]');
  const submitSpinnerEl = document.querySelector<HTMLElement>('[data-submit-spinner]');
  // Start with the spinner hidden — it only shows while the submit
  // request is in flight. Belt-and-suspenders: the HTML already has
  // the `hidden` attribute, but if a browser ever strips it on render
  // (older Safari quirk, ad-blocker, etc.) this JS guard keeps the UI
  // honest.
  if (submitSpinnerEl) submitSpinnerEl.hidden = true;

  function setError(message: string) {
    if (!errorEl || !errorMsgEl) return;
    errorMsgEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorMsgEl!.textContent = '';
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabelEl) return;
    submitBtn.disabled = loading;
    submitLabelEl.textContent = loading ? 'Iniciando sesión…' : 'Iniciar sesión';
    if (submitSpinnerEl) submitSpinnerEl.hidden = !loading;
  }

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault();
    if (!form || !submitBtn) return;

    clearError();
    setLoading(true);

    const formData = new FormData(form);
    const email = String(formData.get('email') ?? '').trim();
    const password = String(formData.get('password') ?? '');
    const redirectTo = form.dataset.redirect || '/admin';

    if (!email || !password) {
      setError('Email y contraseña son obligatorios.');
      setLoading(false);
      return;
    }

    try {
      const response = await fetch('/api/admin/auth/login', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      if (!response.ok) {
        let problem: { title?: string; detail?: string } = {};
        try {
          problem = await response.json();
        } catch {
          // ignore non-JSON
        }
        if (problem.title === 'Auth.InvalidCredentials') {
          setError('Email o contraseña incorrectos.');
        } else {
          setError(problem.detail ?? problem.title ?? 'No se pudo iniciar sesión.');
        }
        setLoading(false);
        return;
      }

      // Success — navigate to the original target.
      window.location.href = redirectTo;
    } catch (err) {
      console.error('Login error:', err);
      setError('Error de red. Verificá que el backend esté corriendo.');
      setLoading(false);
    }
  }

  function bind() {
    form?.addEventListener('submit', handleSubmit);
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  main {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-16);
  }

  .login-shell {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: flex;
    justify-content: center;
  }

  .login-card {
    width: 100%;
    max-width: 28rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-3);
  }

  .login-card h1 {
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .lede {
    color: var(--color-muted);
    margin-bottom: var(--space-8);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-fg);
  }

  .field__input {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 1rem;
    color: var(--color-fg);
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
    min-height: 2.75rem;
  }

  .field__input:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-accent) 18%, transparent);
  }

  .submit-btn {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    transition: transform var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out),
                opacity var(--duration-fast) var(--ease-out);
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px color-mix(in oklab, var(--color-accent) 25%, transparent);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-btn__spinner {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2px solid color-mix(in oklab, var(--color-accent-fg) 30%, transparent);
    border-top-color: var(--color-accent-fg);
    animation: login-spin 0.7s linear infinite;
  }

  .submit-btn__spinner[hidden] {
    display: none;
  }

  @keyframes login-spin {
    to { transform: rotate(360deg); }
  }

  .error {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: #b91c1c;
    font-size: 0.875rem;
    padding: var(--space-3) var(--space-4);
    background-color: color-mix(in oklab, #ef4444 10%, transparent);
    border: 1px solid color-mix(in oklab, #ef4444 28%, transparent);
    border-radius: var(--radius);
  }

  .error[hidden] {
    display: none;
  }

  :global([data-theme='dark']) .error {
    color: #fca5a5;
    background-color: color-mix(in oklab, #ef4444 14%, transparent);
    border-color: color-mix(in oklab, #ef4444 32%, transparent);
  }

  .error__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .login-back {
    display: inline-block;
    margin-top: var(--space-6);
    padding: var(--space-2) 0;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .login-back:hover {
    color: var(--color-fg);
  }

  @media (max-width: 480px) {
    .login-shell {
      padding-inline: var(--space-4);
    }

    .login-card {
      padding: var(--space-6);
      border-radius: var(--radius);
    }

    .login-card h1 {
      font-size: 1.6rem;
    }
  }
</style>