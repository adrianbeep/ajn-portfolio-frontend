---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada — AJN" description="La página que buscás no existe." noindex>
  <div class="container">
    <section class="not-found">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="hero__lede">
        Puede que el enlace esté viejo o que la dirección tenga un error de tipeo.
      </p>
      <a class="button button--primary" href="/">Volver al inicio</a>
    </section>
  </div>
</BaseLayout>
