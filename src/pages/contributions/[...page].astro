---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContributionCard from '../../components/ContributionCard.astro';
import Pagination from '../../components/Pagination.astro';
import { listContributions } from '../../lib/api';

export async function getStaticPaths() {
  // Fetch just enough to know total, then return one path per page after page 1.
  const { total, pageSize } = await listContributions({ page: 1 });
  const totalPages = Math.max(1, Math.ceil(total / pageSize));
  if (totalPages <= 1) return [];
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page: pageStr } = Astro.params;
const pageNum = Number(pageStr);

if (!Number.isInteger(pageNum) || pageNum < 2) {
  return Astro.redirect('/contributions');
}

const { items, total, page, pageSize } = await listContributions({ page: pageNum });
const totalPages = Math.ceil(total / pageSize);
---

<BaseLayout title={`Contributions · Page ${page} · AJN Portfolio`} description="External contributions">
  <main>
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">Writing</span>
        <h1>Contributions</h1>
        <p class="lede">External writing — posts en otros lugares, cuando tengo algo que vale la pena decir.</p>
      </header>

      {items.length === 0 ? (
        <p class="empty">No contributions on this page.</p>
      ) : (
        <div class="contrib-grid">
          {items.map((c, i) => (
            <ContributionCard contribution={c} index={(page - 1) * pageSize + i} />
          ))}
        </div>
      )}

      <Pagination currentPage={page} totalPages={totalPages} basePath="/contributions" />
    </div>
  </main>
</BaseLayout>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }
  main {
    padding-block: var(--space-12) var(--space-24);
  }
  .page-header {
    margin-bottom: var(--space-12);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-block: var(--space-3) var(--space-4);
  }
  .lede {
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 38rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .eyebrow::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: var(--color-accent);
    display: inline-block;
  }
  .empty {
    color: var(--color-muted);
    font-style: italic;
    padding-block: var(--space-12);
    text-align: center;
  }
  .contrib-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }
</style>