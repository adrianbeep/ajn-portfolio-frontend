---
/**
 * Breadcrumb — compact breadcrumb trail rendered in the admin topbar.
 *
 * The LAST item in `items` is the current page and is rendered as text
 * with `aria-current="page"` (no link). Earlier items are anchors.
 * Separators use the arrow glyph to match the visual language of the
 * dashboard's "Ver todo →" link.
 *
 * Markup uses <ol> for semantic ordering — the WAI-ARIA spec for
 * breadcrumbs recommends an ordered list.
 */

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb__list">
    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="breadcrumb__item">
          {!isLast && item.href ? (
            <a href={item.href} class="breadcrumb__link">{item.label}</a>
          ) : (
            <span class="breadcrumb__current" aria-current="page">{item.label}</span>
          )}
          {!isLast && (
            <svg
              class="breadcrumb__sep"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    min-width: 0;
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .breadcrumb__link {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18rem;
  }

  .breadcrumb__link:hover {
    color: var(--color-fg);
  }

  .breadcrumb__current {
    color: var(--color-fg);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 18rem;
  }

  .breadcrumb__sep {
    color: var(--color-muted);
    opacity: 0.5;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .breadcrumb__link,
    .breadcrumb__current {
      max-width: 10rem;
    }
  }
</style>