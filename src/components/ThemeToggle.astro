<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
  <span class="theme-toggle__icon" aria-hidden="true" data-theme-icon>◐</span>
  <span data-theme-label>Tema</span>
</button>

<script is:inline>
  // Único JavaScript del sitio público: el toggle de tema.
  (() => {
    const root = document.documentElement;

    const paint = (button) => {
      const isLight = root.dataset.theme === "light";
      const label = button.querySelector("[data-theme-label]");
      const icon = button.querySelector("[data-theme-icon]");

      if (label) label.textContent = isLight ? "Claro" : "Oscuro";
      if (icon) icon.textContent = isLight ? "☀" : "☾";

      // El estado tiene que quedar expuesto a la tecnología asistiva: sin
      // esto, un lector de pantalla anuncia lo mismo antes y después de
      // cambiar el tema, y no dice si el control lo enciende o lo apaga.
      button.setAttribute("aria-pressed", String(isLight));
    };

    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
        paint(button);
      });

      paint(button);
    });
  })();
</script>
