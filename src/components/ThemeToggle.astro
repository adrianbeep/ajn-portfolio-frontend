<button class="theme-toggle" aria-label="Toggle theme" data-theme-toggle>
  <svg class="icon icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="icon icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  // Binding lives in src/scripts/theme-toggle.ts so admin and public share it.
  import '../scripts/theme-toggle';
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-fg);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--color-fg);
  }

  .theme-toggle .icon {
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* The visibility rule lives in global.css (plain class selectors,
     not scoped) so it survives ClientRouter soft navigations. */
</style>