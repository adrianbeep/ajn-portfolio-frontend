<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
  <span class="theme-toggle__icon" aria-hidden="true" data-theme-icon>◐</span>
  <span data-theme-label>Tema</span>
</button>

<script is:inline>
  // Único JavaScript del sitio público: el toggle de tema.
  (() => {
    const root = document.documentElement;

    // Convierte un tiempo CSS ("240ms", ".24s") a milisegundos.
    //
    // El navegador serializa los tiempos en segundos: el token se declara
    // como `240ms` pero su valor computado llega como `.24s`. Parsear a
    // ciegas daría 0.24 y una transición de un cuarto de milisegundo.
    const toMs = (value) => {
      const match = /^([0-9]*\.?[0-9]+)(ms|s)$/.exec(value.trim());
      if (!match) return Number.NaN;
      const amount = Number.parseFloat(match[1]);
      return match[2] === "s" ? amount * 1000 : amount;
    };

    // Duración de la transición del tema, en ms.
    //
    // Se lee del token para que el script y el CSS no se desincronicen. El
    // margen va a propósito: si el atributo que habilita la transición se
    // saca antes de que termine, el color queda a medio camino.
    const readThemeDuration = () => {
      const parsed = toMs(getComputedStyle(root).getPropertyValue("--duration-theme"));
      return Number.isFinite(parsed) && parsed > 0 ? parsed + 20 : 260;
    };

    const paint = (button) => {
      const isLight = root.dataset.theme === "light";
      const label = button.querySelector("[data-theme-label]");
      const icon = button.querySelector("[data-theme-icon]");

      if (label) label.textContent = isLight ? "Claro" : "Oscuro";
      if (icon) icon.textContent = isLight ? "☀" : "☾";

      // El estado tiene que quedar expuesto a la tecnología asistiva: sin
      // esto, un lector de pantalla anuncia lo mismo antes y después de
      // cambiar el tema, y no dice si el control lo enciende o lo apaga.
      button.setAttribute("aria-pressed", String(isLight));
    };

    // La transición del tema vive en el atributo `data-theme-switch`: hay que
    // ponerlo ANTES de cambiar el valor del token, porque la transición se
    // declara en el momento del cambio. Después se saca, para que un cambio
    // posterior no anime nada.
    let themeSwitchTimer = 0;

    const switchTheme = () => {
      root.setAttribute("data-theme-switch", "");
      root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";

      window.clearTimeout(themeSwitchTimer);
      themeSwitchTimer = window.setTimeout(() => {
        root.removeAttribute("data-theme-switch");
      }, readThemeDuration());
    };

    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        switchTheme();
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
        paint(button);
      });

      paint(button);
    });
  })();
</script>
