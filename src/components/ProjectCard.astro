---
import type { ProjectSummaryDto } from '../lib/types';

interface Props {
  project: ProjectSummaryDto;
  variant?: 'featured' | 'default';
}

const { project, variant = 'default' } = Astro.props;
const glyph = project.title.charAt(0).toUpperCase();
const isFeatured = variant === 'featured';
---

<a
  href={`/projects/${project.slug}`}
  class:list={['proj-card', { 'proj-card--big': isFeatured }]}
>
  <div class="proj-card__cover">
    <span class="proj-card__cover-glyph" aria-hidden="true">{glyph}</span>
    {project.urlThumbnail && (
      <img
        class="proj-card__cover-img"
        src={project.urlThumbnail}
        alt=""
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'"
      />
    )}
  </div>
  <div class="proj-card__body">
    <div class="proj-card__meta">
      <span class="proj-card__type">{project.slug}</span>
    </div>
    <h3 class="proj-card__title">{project.title}</h3>
    <p class="proj-card__desc">{project.description}</p>
  </div>
</a>

<style>
  .proj-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .proj-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-fg);
    box-shadow: 0 10px 30px color-mix(in oklab, var(--color-fg) 6%, transparent);
  }
  .proj-card:hover .proj-card__title {
    color: var(--color-accent);
  }
  .proj-card:hover .proj-card__cover-glyph {
    transform: scale(1.05);
  }

  .proj-card__cover {
    aspect-ratio: 16 / 9;
    background: color-mix(in oklab, var(--color-fg) 4%, var(--color-surface));
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .proj-card__cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in oklab, var(--color-accent) 18%, transparent),
      transparent 60%
    );
    pointer-events: none;
  }
  .proj-card__cover-glyph {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 500;
    font-style: italic;
    color: var(--color-fg);
    letter-spacing: -0.05em;
    z-index: 1;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .proj-card__cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
  }

  .proj-card--big .proj-card__cover {
    aspect-ratio: 4 / 3;
  }
  .proj-card--big .proj-card__cover-glyph {
    font-size: clamp(5rem, 12vw, 8rem);
  }

  .proj-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .proj-card--big .proj-card__body {
    padding: var(--space-8);
    gap: var(--space-3);
  }

  .proj-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }
  .proj-card__type {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .proj-card__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .proj-card--big .proj-card__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .proj-card__desc {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .proj-card--big .proj-card__desc {
    font-size: 1rem;
  }
</style>