---
import type { ProjectWithDetail } from "../lib/types";

interface Props {
  project: ProjectWithDetail;
  /**
   * Nivel del encabezado del título del proyecto.
   *
   * La tarjeta se usa bajo un h2 (en la home, dentro de la sección
   * "Proyectos") y bajo un h1 (en el listado, que es el título de la
   * página). El nivel correcto depende del contexto, así que lo recibe
   * explícitamente: un encabezado que salta niveles rompe la jerarquía
   * para quien navega con un lector de pantalla.
   */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const year = new Date(project.createdAt).getUTCFullYear();
const monogram = project.title
  .split(/\s+/)
  .filter((word) => word.length > 0)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? "")
  .join("");
---

<a class="card" href={`/projects/${project.slug}/`}>
  <span class="card__cover">
    {
      project.urlThumbnail && (
        <img
          class="card__cover-image"
          src={project.urlThumbnail}
          alt=""
          loading="lazy"
          decoding="async"
          onerror="this.remove()"
        />
      )
    }
    <span aria-hidden="true">{monogram}</span>
  </span>
  <span class="card__body">
    <Heading class="card__title">{project.title}</Heading>
    <p class="card__description">{project.description}</p>
    <span class="card__meta">
      <span>{year} · {project.state}</span>
      <span class="card__more">Ver proyecto</span>
    </span>
  </span>
</a>
