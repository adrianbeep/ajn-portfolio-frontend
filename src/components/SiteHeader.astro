---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/projects', label: 'Proyectos' },
  { href: '/contributions', label: 'Contribuciones' },
  { href: '#contact', label: 'Contactar', dataOpenContact: true },
];

function isCurrent(href: string): boolean {
  if (href.startsWith('mailto:')) return false;
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <span class="brand__dot" aria-hidden="true"></span>
      AJN
    </a>
    <nav class="nav" aria-label="Principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          {...(item.dataOpenContact ? { 'data-open-contact': '' } : {})}
        >{item.label}</a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in oklab, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 50%, transparent);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-fg);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand__dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: #10b981;
    transform: translateY(-0.15em);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .nav__link {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link.is-current {
    color: var(--color-fg);
  }
  @media (max-width: 640px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: var(--space-3);
    }
    .nav {
      gap: var(--space-3);
      width: 100%;
      justify-content: flex-end;
    }
    .nav__link {
      font-size: 0.85rem;
    }
  }
</style>
