---
import { buildPagination, pageHref } from "../lib/pagination";

interface Props {
  /** Página actual (1-based). */
  currentPage: number;
  /** Cantidad total de páginas. */
  lastPage: number;
  /** Total de ítems del catálogo, no de la página. */
  total: number;
  /** Tamaño de página aplicado. */
  pageSize: number;
  /** Base del listado sin barra final (ej. "/projects"). */
  baseUrl: string;
  /** Nombre del catálogo: arma el label del nav ("Paginación de proyectos"). */
  label?: string;
}

const { currentPage, lastPage, total, pageSize, baseUrl, label = "Paginación" } = Astro.props;

/** El modelo lo calcula la función pura de src/lib/pagination.ts. */
const model = buildPagination({ currentPage, lastPage, total, pageSize });

/** Las URLs se arman acá: las rutas son segmentos, no query params. */
const href = (page: number) => pageHref(baseUrl, page);
---

{
  model.lastPage > 1 && (
    <nav class="pagination" aria-label={label}>
      <p class="pagination__range">
        {model.from}-{model.to} de {model.total}
      </p>
      <ol class="pagination__list">
        {model.hasPrevious && (
          <li class="pagination__item">
            <a
              class="pagination__link pagination__link--step"
              href={href(model.currentPage - 1)}
              rel="prev"
            >
              <span class="pagination__chevron" aria-hidden="true">‹</span>
              <span class="pagination__label">Anterior</span>
            </a>
          </li>
        )}
        {model.items.map((item) =>
          item.kind === "gap" ? (
            <li class="pagination__item pagination__item--gap" aria-hidden="true">
              …
            </li>
          ) : (
            <li class="pagination__item">
              <a
                class:list={[
                  "pagination__link",
                  item.page === model.currentPage && "pagination__link--current",
                ]}
                href={href(item.page)}
                aria-current={item.page === model.currentPage ? "page" : undefined}
              >
                {item.page}
              </a>
            </li>
          ),
        )}
        {model.hasNext && (
          <li class="pagination__item">
            <a
              class="pagination__link pagination__link--step"
              href={href(model.currentPage + 1)}
              rel="next"
            >
              <span class="pagination__label">Siguiente</span>
              <span class="pagination__chevron" aria-hidden="true">›</span>
            </a>
          </li>
        )}
      </ol>
    </nav>
  )
}
