---
import type { ContributionSummaryDto } from '../lib/types';

interface Props {
  contribution: ContributionSummaryDto;
  index?: number;
}

const { contribution, index = 0 } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a href={`/contributions/${contribution.slug}`} class="contrib-card">
  <div class="contrib-card__cover">
    <span class="contrib-card__num" aria-hidden="true">{num}</span>
  </div>
  <div class="contrib-card__body">
    <div class="contrib-card__meta">
      <span>Externo</span>
    </div>
    <h3 class="contrib-card__title">{contribution.title}</h3>
    <p class="contrib-card__desc">{contribution.description}</p>
  </div>
</a>

<style>
  .contrib-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .contrib-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-fg);
    box-shadow: 0 10px 30px color-mix(in oklab, var(--color-fg) 6%, transparent);
  }
  .contrib-card:hover .contrib-card__title {
    color: var(--color-accent);
  }

  .contrib-card__cover {
    aspect-ratio: 3 / 2;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-fg) 3%, var(--color-surface)),
      var(--color-surface)
    );
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .contrib-card__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 100%,
      color-mix(in oklab, var(--color-fg) 4%, transparent),
      transparent 60%
    );
    pointer-events: none;
  }
  .contrib-card__num {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 500;
    font-style: italic;
    color: var(--color-fg);
    letter-spacing: -0.04em;
    z-index: 1;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .contrib-card:hover .contrib-card__num {
    transform: scale(1.05);
  }

  .contrib-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .contrib-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .contrib-card__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-fg);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .contrib-card__desc {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>